# Copia a .env en el servidor y completa. La app NO arranca si falta algo importante.
DOMAIN=lavados.tudominio.com
APP_URL=https://lavados.tudominio.com
BUSINESS_TZ=America/Bogota
BUSINESS_PHONE=300 000 0000

# Primer administrador (solo se usa si todavía no existe ninguno; luego se gestiona desde el panel)
ADMIN_EMAIL=
ADMIN_PASSWORD=          # mínimo 12 caracteres
ADMIN_NAME=Administrador

# Correo saliente (recuperar contraseña, invitaciones y recordatorios) — SMTP de tu proveedor
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dip House <no-reply@tudominio.com>

# Recordatorios automáticos
NOTIFY_ENABLED=true
EMPLOYEE_DIGEST_HOUR=6       # hora local en que cada empleado recibe sus servicios del día
CUSTOMER_REMINDER_HOUR=17    # hora local del recordatorio al cliente el día anterior (+ otro ~2 h antes)

# Evidencias del vehículo (fotos/videos que sube el cliente al agendar)
EVIDENCE_MAX_MB=150

# Mercado Pago (credenciales de PRODUCCIÓN cuando todo esté probado)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
