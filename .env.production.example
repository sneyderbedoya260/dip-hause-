# Copia a .env en el servidor y completa. La app NO arranca si falta algo importante.
APP_IMAGE=ghcr.io/TU_USUARIO/dip-house:latest     # imagen compilada por GitHub (el servidor solo la descarga)
DOMAIN=lavados.tudominio.com
APP_URL=https://lavados.tudominio.com
BUSINESS_TZ=America/Bogota

# Seguridad
DATA_KEY=            # 32+ caracteres aleatorios: cifra los secretos de 2FA (openssl rand -base64 48). ¡Guárdala! Si se pierde, hay que reconfigurar el 2FA.
REQUIRE_2FA=true     # el personal debe activar verificación en dos pasos

# Primer administrador (solo se usa si todavía no existe ninguno; luego se gestiona desde el panel)
ADMIN_EMAIL=
ADMIN_PASSWORD=          # mínimo 12 caracteres
ADMIN_NAME=Administrador

# Datos del negocio (aparecen en la política de privacidad y términos)
BUSINESS_LEGAL_NAME=
BUSINESS_NIT=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=

# Correo saliente (recuperar contraseña, verificación y recordatorios). Hetzner bloquea 25 y 465: usa 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dip House <no-reply@tudominio.com>

# Recordatorios automáticos
NOTIFY_ENABLED=true
EMPLOYEE_DIGEST_HOUR=6       # hora local en que cada empleado recibe sus servicios del día
CUSTOMER_REMINDER_HOUR=17    # hora local del recordatorio al cliente el día anterior (+ otro ~2 h antes)

# Archivos
EVIDENCE_MAX_MB=150
UPLOAD_MAX_MB=200

# Mercado Pago (credenciales de PRODUCCIÓN cuando todo esté probado)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
