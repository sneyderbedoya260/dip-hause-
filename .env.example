# Desarrollo: copia a apps/web/.env.local  (producción: .env.production.example)
DATABASE_URL=file:./dev.db
APP_URL=http://localhost:3000
BUSINESS_TZ=America/Bogota
# Sin ADMIN_EMAIL/ADMIN_PASSWORD se crea admin@dip.local / admin-dev-12345 (solo en desarrollo)
# Sin SMTP_HOST los correos se imprimen en la consola
# NOTIFY_ENABLED=true  para probar los recordatorios
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
